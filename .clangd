CompileFlags:
  Add:
    - "-Wno-deprecated-volatile"
    - "-Wno-vla-cxx-extension"
    - "-Wno-unknown-pragmas"
    - "-ferror-limit=0"
    - "-D__GNUC__=13"
    - "-D__GNUC_MINOR__=3"
    - "-D__GNUC__PATCHLEVEL__=1"
    - "-std=c++23"
  Remove:
    - "-Wno-deprecated-declarations"
    - "-fno-extended-identifiers"
---
# The clang-tidy checks of .clang-tidy are for our code, not for the vendored libraries.
If:
  PathExclude: [src/.*, lib/Marlin/.*, tests/.*]
Diagnostics:
  ClangTidy:
    Remove: '*'
