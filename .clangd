CompileFlags:
  Add:
    - "-Wno-deprecated-volatile"
    - "-Wno-vla-cxx-extension"
    - "-Wno-unknown-pragmas"
    - "-ferror-limit=0"
    - "-D__GNUC__=16"
    - "-D__GNUC_MINOR__=2"
    - "-D__GNUC__PATCHLEVEL__=0"
    - "-std=c++23"
  Remove:
    - "-Wno-deprecated-declarations"
    - "-fno-extended-identifiers"
